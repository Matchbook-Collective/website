---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
---
<Base title="Thank you" description="Thank you for starting a conversation with The Matchbook Collective Agency." noindex>
  <section class="page-intro wrap">
    <p class="eyebrow">A conversation worth starting.</p>
    <h1>Message received.<br /><em>Let’s find your spark.</em></h1>
    <p>Thank you for sharing what’s next for your business. Megan and Heather will review your note and get back to you at the email address you provided.</p>
    <Link href="/" variant="button">Back to Matchbook</Link>
  </section>
</Base>
