---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Link from '../components/Link.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { beliefs, needs, promises } from '../data/site';
import { services } from '../data/services';
---

<Base title="A clearer way to grow">
  <section class="home-hero wrap">
    <div class="hero-topline">
      <p class="hero-prelude">You don’t need more marketing.</p>
      <span class="micro">Strategy meets possibility.</span>
    </div>
    <div class="hero-composition">
      <div class="hero-copy">
        <h1>
          You need a plan
          <br class="wide-only" /> that moves the
          <br class="wide-only" /> business <em>forward.</em>
        </h1>
        <p class="hero-description">
          Matchbook Collective helps brands find the spark, build the strategy,
          and turn it into momentum.
        </p>
        <div class="hero-actions">
          <Link href="/contact" variant="button">
            Start a conversation
          </Link>
          <Link href="/method">Explore the Matchbook Method</Link>
        </div>
      </div>
      <figure class="hero-figure">
        <Photo
          kind="agency"
          eager
          class="hero-photo"
          sizes="(max-width: 700px) 100vw, 43vw"
        />
        <figcaption>
          <span>Small spark. Bigger picture.</span>
          <span aria-hidden="true">01 / MB</span>
        </figcaption>
      </figure>
    </div>
    <div class="hero-baseline">
      <span>Strategy · Brand · Creative · Growth</span>
      <a href="#point-of-view">
        A different way to look at it <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <section id="point-of-view" class="manifesto wrap section-space">
    <div class="section-intro">
      <p class="eyebrow">01 / Our point of view</p>
      <h2>
        Before we add
        <br />
        anything,
        <br />
        <em>we look closer.</em>
      </h2>
      <p>
        Growth isn’t one-size-fits-all. And more marketing activity isn’t
        automatically the answer.
      </p>
    </div>
    <div class="belief-list">
      {beliefs.map((belief, i) => (
        <article>
          <span class="micro">0{i + 1}</span>
          <div>
            <h3>{belief.title}</h3>
            <p>{belief.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="needs-section section-space">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">02 / Start where you are</p>
        <h2>
          What do you need
          <br />
          <em>right now?</em>
        </h2>
        <p>
          You don’t need to know the name of the service.
          <br />
          Just what you’d like to change.
        </p>
      </div>
      <div class="needs-list">
        {needs.map((need, i) => (
          <a href={need.href}>
            <span class="micro">0{i + 1}</span>
            <h3>
              I need <em>{need.word}.</em>
            </h3>
            <p>{need.detail}</p>
            <span class="need-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="packages-section wrap section-space" aria-labelledby="packages-heading">
    <div class="packages-heading">
      <p class="eyebrow">03 / Our packages</p>
      <h2 id="packages-heading">Need something simple? <em>We also offer these quick starter packages below.</em></h2>
    </div>
    <div class="packages-grid">
      <article class="package-card">
        <p class="eyebrow package-price">$1,000 / Megan</p>
        <h3>Growth Roadmap</h3>
        <p class="package-summary">Get a customized 90-day plan for one business goal and know what to do first.</p>
        <h4>What is included</h4>
        <ul>
          <li>Short intake and a focused review of the client’s offer and current marketing.</li>
          <li>60-minute strategy call to choose one goal, one priority audience, and up to two channels.</li>
          <li>90-day roadmap with a first-week checklist, milestones at 30, 60, and 90 days, and two or three metrics to track.</li>
          <li>One practical tool matched to the goal, such as a referral checklist, prospect tracker, or weekly marketing schedule.</li>
        </ul>
      </article>
      <article class="package-card">
        <p class="eyebrow package-price">$1,000 / Heather</p>
        <h3>Brand Essentials</h3>
        <p class="package-summary">Get a cohesive visual identity you can start using across your business.</p>
        <h4>What is included</h4>
        <ul>
          <li>Short brand questionnaire and visual direction.</li>
          <li>One logo concept developed into a primary logo and a secondary mark.</li>
          <li>Facebook Page and LinkedIn cover banners.</li>
          <li>Color palette with hex codes and primary and supporting font selections.</li>
          <li>One consolidated revision round.</li>
        </ul>
      </article>
      <article class="package-card package-launch">
        <p class="eyebrow package-price">$2,500 / Megan and Heather</p>
        <h3>Brand and Growth Launch Kit</h3>
        <p class="package-summary">Get a visual identity, a 90-day growth plan, and outreach materials you can use to start conversations.</p>
        <div class="package-launch-details">
          <div>
            <h4>What is included</h4>
            <ul>
              <li>Shared kickoff to align the growth plan, brand, and outreach around the same offer.</li>
              <li>Megan’s full Growth Roadmap, including the strategy call, 90-day plan, and one practical tool.</li>
              <li>Heather’s full Brand Essentials package, including the logo, secondary mark, colors, fonts, Facebook and LinkedIn banners, and usage guide.</li>
            </ul>
          </div>
          <div>
            <h4>Branded outreach kit</h4>
            <ul>
              <li>One shareable branded one-pager explaining your offers, who it’s for, and how to take the next step.</li>
              <li>One introductory email template and 5 social media templates for promotions.</li>
              <li>A two-week outreach schedule showing when to send each message and follow up.</li>
            </ul>
          </div>
        </div>
      </article>
    </div>
  </section>
  <section class="services-preview wrap section-space">
    <div class="section-intro">
      <p class="eyebrow">04 / Ways to move forward</p>
      <h2>
        The right thinking.
        <br />
        <em>The right support.</em>
      </h2>
      <p>
        From a focused strategic engagement to an ongoing growth partnership, we
        meet you where the business is.
      </p>
      <Link href="/services">Find your way to work with us</Link>
    </div>
    <div class="service-index">
      {services.map((service) => (
        <a href={`/services#${service.id}`}>
          <span class="micro">{service.number}</span>
          <h3>{service.name}</h3>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <section class="founder-preview">
    <Photo kind="paper" class="founder-photo" />
    <div class="founder-copy">
      <p class="eyebrow">05 / Meet the collective</p>
      <h2>
        Two perspectives.
        <br />
        <em>One shared belief.</em>
      </h2>
      <p>
        Good marketing shouldn’t feel like throwing ideas at a wall and hoping
        something sticks.
      </p>
      <p>
        Megan and Heather created Matchbook around a more useful kind of
        partnership: one that brings the business, the brand, and the work into
        the same conversation.
      </p>
      <p class="founder-names">
        Megan <span>+</span> Heather
      </p>
      <Link href="/about">Meet Megan + Heather</Link>
    </div>
  </section>
  <section class="proof-preview wrap section-space">
    <p class="eyebrow">06 / The work & the thinking</p>
    <h2>
      The work matters.
      <br />
      <em>So does the thinking behind it.</em>
    </h2>
    <div class="proof-bottom">
      <p>
        We’re building our collection of Matchbook projects, selected founder
        experience, and clearly labeled concept work. In the meantime, explore
        the thinking that shapes our approach.
      </p>
      <Link href="/work">Inside our work</Link>
    </div>
  </section>
  <section class="promise-section wrap">
    <p class="eyebrow">07 / What you get with us</p>
    <div>
      {promises.map((promise) => (
        <p>{promise}</p>
      ))}
    </div>
    <p class="promise-note">
      A direct relationship.
      <br />A practical next step.
      <br />
      People in your corner.
    </p>
  </section>
  <FinalCTA />
</Base>

<style>
  .packages-section { border-bottom: 1px solid var(--rule); }
  .packages-heading { margin-bottom: 40px; }
  .packages-heading .eyebrow { margin-bottom: 22px; }
  .packages-heading em { color: var(--italic-accent); }
  .packages-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .package-card { padding: clamp(24px, 3.2vw, 48px); border: 1px solid var(--rule); background: var(--cream); }
  .package-price { margin-bottom: 22px; color: var(--bronze); }
  .package-card h3 { font-size: clamp(34px, 3.2vw, 46px); }
  .package-summary { margin-top: 20px; }
  .package-card h4 { margin: 28px 0 14px; font: 600 12px/1.5 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .package-card ul { margin: 0; padding-left: 20px; }
  .package-card li { padding-left: 4px; }
  .package-card li + li { margin-top: 12px; }
  .package-card li::marker { color: var(--bronze); }
  .package-launch { grid-column: 1 / -1; background: var(--ink); color: var(--paper); }
  .package-launch .package-price, .package-launch li::marker { color: var(--sand); }
  .package-launch-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  @media (max-width: 850px) {
    .packages-grid, .package-launch-details { grid-template-columns: 1fr; }
    .package-launch-details { gap: 0; }
  }
</style>
