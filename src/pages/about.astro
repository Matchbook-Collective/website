---
import Base from '../layouts/Base.astro';
import WorkCollection from '../components/WorkCollection.astro';
import Photo from '../components/Photo.astro';
import Link from '../components/Link.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { founders as founderData, originStory } from '../data/founders';
import { promises } from '../data/site';

const heatherBio = `Hi! I’m Heather — a creative at heart with a love for anything that has to do with style - whether it be within fashion, interior design, branding, and aesthetic. I’m a proud West Coast girl, originally from San Diego, CA who loves working out, health and wellness, creating content, reading, exploring new places, and traveling. I moved up to LA in my 20s to pursue all the “LA” things from attempting to become an actress (of course!) to serving at a bar in Hollywood to interning for Entertainment Tonight to becoming a Stylist at Nordstrom taking clients all throughout Southern California. I’ve also lived in Scottsdale, AZ where I had to the opportunity to work for Restoration Hardware assisting designers with product deliveries and installations in the home. I’ve always been someone who loves being a part of the luxury world, elevating the client experience which is what my vision for The Matchbook Collective is.

With all my experiences, I have come to learn how important it is to create connection and serve others. I believe that first impressions and presentation is everything which is why I feel branding is so important when it comes to a business. Using my creativity to turn ideas into something people can actually see, feel, and connect with is something I value and I hope people see the value in that as well.

For me, Matchbook grew from the idea that the best brands aren’t just beautiful — they have personality, purpose, and a spark that makes people remember them. I love getting to know the people behind a business, figuring out what makes their idea special, and helping bring that vision to life in a way that feels completely their own. You know how people have a signature look? I would love to bring that “signature look” energy into their business.

Whether I’m dreaming up a brand concept, planning content, or finding the little details that pull everything together, I thrive when my creativity, ideas, and vision meet. I love seeing the idea come to life and Matchbook is my way of turning that passion into something that helps other people feel just as excited about their brand as they did when the idea first began. Now let’s match and create something special together!`;
const founders = founderData.map((founder) =>
  founder.name === 'Heather' ? { ...founder, bio: heatherBio } : founder,
);
---

<Base
  title="About Megan + Heather"
  description="The belief behind Matchbook: a more useful kind of agency partnership, connecting business strategy, creative thinking, and practical action."
>
  <section class="page-intro wrap">
    <p class="eyebrow">The people behind the spark</p>
    <h1 class="about-headline">
      <span>Good thinking. Good chemistry.</span>
      <em>Better together.</em>
    </h1>
    <div class="intro-bottom">
      <span class="micro">Megan + Heather / Co-founders</span>
      <p>
        Two different perspectives. One shared belief: businesses deserve a
        clearer, more practical way to grow.
      </p>
    </div>
  </section>
  <section class="about-belief">
    <Photo kind="paper" class="about-photo" eager />
    <div class="about-belief-copy">
      <p class="eyebrow">Why Matchbook exists</p>
      <h2>
        There has to be
        <br />
        <em>a more useful way.</em>
      </h2>
      <p>
        More posts. Another campaign. A new brand direction. It’s easy for
        marketing to become a list of things to do.
      </p>
      <p>
        We believe the better starting point is the business itself: what you’re
        building, who you’re reaching, and what’s getting in the way.
      </p>
      <p>
        Matchbook brings strategic and creative thinking together, then connects
        that thinking to work you can actually use.
      </p>
    </div>
  </section>
  {originStory && (
    <section class="wrap section-space">
      <p class="eyebrow">Our story</p>
      <p>{originStory}</p>
    </section>
  )}
  <section class="founders-section wrap section-space">
    <div class="section-heading">
      <p class="eyebrow">Meet the co-founders</p>
      <h2>
        <em>Megan + Heather.</em>
      </h2>
      <p>Different perspectives belong at the same table.</p>
    </div>
    <div class="founder-profiles">
      {founders.map((founder, i) => (
        <article>
          <span class="micro">
            0{i + 1} / {founder.role}
          </span>
          <h3>{founder.name}</h3>
          {founder.portrait && (
            <img
              src={founder.portrait}
              alt={founder.name}
              width="600"
              height="750"
              loading="lazy"
            />
          )}
          {founder.bio ? (
            founder.bio.split('\n\n').map((paragraph) => <p>{paragraph}</p>)
          ) : (
            <p class="profile-coming">A closer introduction is on its way.</p>
          )}
          {founder.careerHighlights.length > 0 && (
            <ul>
              {founder.careerHighlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}
          {founder.personalDetail && <p>{founder.personalDetail}</p>}
          <a href="/contact">
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>
  <section class="together dark-section section-space">
    <div class="wrap">
      <p class="eyebrow">Better together</p>
      <h2>
        The business.
        <br />
        The brand.
        <br />
        <em>The bigger picture.</em>
      </h2>
      <div class="together-copy">
        <p>
          Strong ideas need a business reason. A business strategy needs a clear
          way to show up in the world.
        </p>
        <p>
          We bring those conversations together—connecting the offer, the
          message, the customer experience, and the next practical move.
        </p>
      </div>
    </div>
  </section>
  <section class="about-promise wrap section-space">
    <div>
      <p class="eyebrow">What clients get with us</p>
      <h2>
        Senior thinking.
        <br />
        <em>Human approach.</em>
      </h2>
    </div>
    <div class="lined-list">
      {promises.map((promise, i) => (
        <p>
          <span class="micro">0{i + 1}</span>
          {promise}
        </p>
      ))}
      <p class="plain-note">
        No bloated agency layers. No strategy deck designed to disappear into a
        folder.
      </p>
      <Link href="/method">See how we think</Link>
    </div>
  </section>
  <WorkCollection foundersOnly />
  <FinalCTA />
</Base>
